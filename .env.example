# GitHub Personal Access Token (classic with `read:user` and `public_repo` scopes, or fine-grained)
# Used on the serverless API (/api/github) and scripts to prevent rate-limiting.
GITHUB_TOKEN=your_github_token_here

# Contact Form Email Delivery (Resend API)
# Optional in development; recommended in production on Vercel.
# Sign up at https://resend.com to generate a free API key.
RESEND_API_KEY=re_your_resend_api_key_here
CONTACT_TO_EMAIL=thivankatharuka36@gmail.com
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
